// File name: projects/01/DMux8Way.hdl

/**
 * 8-way demultiplexor:
 * {a, b, c, d, e, f, g, h} = {in, 0, 0, 0, 0, 0, 0, 0} if sel == 000
 *                            {0, in, 0, 0, 0, 0, 0, 0} if sel == 001
 *                            etc.
 *                            {0, 0, 0, 0, 0, 0, 0, in} if sel == 111
 */

CHIP DMux8Way {
    IN in, sel[3];
    OUT a, b, c, d, e, f, g, h;

    PARTS:
    // Put your code here:
    DMux(in=in, sel=sel[2], a=top, b=bottom);
    DMux(in=top, sel=sel[1], a=t0, b=t1);
    DMux(in=bottom, sel=sel[1], a=b0, b=b1);
    DMux(in=t0, sel=sel[0], a=a, b=b);
    DMux(in=t1, sel=sel[0], a=c, b=d);
    DMux(in=b0, sel=sel[0], a=e, b=f);
    DMux(in=b1, sel=sel[0], a=g, b=h);
}